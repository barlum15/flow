# Recorded consumption data is NOT ours to publish. It must never be committed.
# Put the original files into data/raw/; the import script writes data/real/.
# Both folders stay local only.
data/raw/
data/real/
*.h5
*.hdf5
*.hdf

# Trained NILM models and their local configuration/adapter. Loading a pickle
# runs code, and the models are not ours to publish: never commit them.
models/
*.pkl
*.pickle
*.pt
*.pth

# Python
__pycache__/
*.pyc
.venv/
venv/
